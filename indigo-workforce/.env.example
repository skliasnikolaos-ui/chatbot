# Copy to .env (never commit .env). All values are read from the environment.
INDIGO_PRODUCT_NAME="INDIGO WORKFORCE"
# SQLite (pilot/dev) or PostgreSQL: postgresql+psycopg://user:pass@host/dbname
INDIGO_DATABASE_URL=sqlite:///var/indigo.sqlite3
# REQUIRED in production: long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
INDIGO_SECRET_KEY=
# 1 when served over HTTPS (sets Secure flag on cookies)
INDIGO_COOKIE_SECURE=0
INDIGO_ENV=development
INDIGO_LOG_FILE=var/indigo.log
INDIGO_SOLVER_WORKERS=4
